<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bille" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/bille_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bille_purple</item>
        <item name="colorSurface">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/bille_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/Widget.Bille.Button</item>
        <item name="checkboxStyle">@style/Widget.Bille.CheckBox</item>
    </style>

    <style name="Widget.Bille.Button" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">@color/button_background</item>
        <item name="android:textColor">@color/button_text</item>
    </style>

    <style name="Widget.Bille.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="buttonTint">@color/bille_green</item>
    </style>

    <style name="TextAppearance.Bille.FieldLabel" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">@color/bille_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Bille.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintEnabled">false</item>
        <item name="errorEnabled">false</item>
    </style>

    <style name="ThemeOverlay.Bille.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Bille.BottomSheet</item>
    </style>

    <style name="Widget.Bille.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/white</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Bille.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Bille.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
