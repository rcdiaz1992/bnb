<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_onboarding"
    app:startDestination="@id/informationFragment">

    <fragment
        android:id="@+id/informationFragment"
        android:name="com.bille.app.information.InformationFragment"
        android:label="@string/step_information">
        <action
            android:id="@+id/action_information_to_authentication"
            app:destination="@id/authenticationFragment" />
    </fragment>

    <fragment
        android:id="@+id/authenticationFragment"
        android:name="com.bille.app.authentication.AuthenticationFragment"
        android:label="@string/step_authentication">
        <argument
            android:name="receiptId"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
</navigation>
